---
import Layout from "../layouts/Layout.astro";

const name = "Garrett Denton";
const title = "Data Engineering & Business Intelligence";
const introduction =
  "Business Intelligence professional building toward data engineering through hands-on projects, technical documentation, and continuous learning.";
---

<Layout
  title={`${name} | ${title}`}
  description={`${name} — ${title}. Personal portfolio, projects, resume, and technical documentation.`}
>
  <div class="container">
    <section class="hero">
      <p class="eyebrow">DATA ENGINEERING · BUSINESS INTELLIGENCE</p>

      <h1>{name}</h1>

      <h2>{title}</h2>

      <p class="introduction">{introduction}</p>

      <div class="links">
        <a href="/resume">Resume</a>
        <a href="/projects">Projects</a>
        <a
          href="https://github.com/garrettpdenton"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
      </div>
    </section>

    <section>
      <h2>Core Skills</h2>

      <div class="skills">
        <span>SQL</span>
        <span>Python</span>
        <span>Data Engineering</span>
        <span>Data Warehousing</span>
        <span>ETL / ELT</span>
        <span>Business Intelligence</span>
        <span>Cloud Data Platforms</span>
        <span>Data Modeling</span>
      </div>
    </section>

    <section>
      <h2>Currently Learning</h2>

      <p>
        Building deeper experience in modern data engineering, cloud platforms,
        orchestration, CI/CD, and MLOps through hands-on projects.
      </p>
    </section>
  </div>
</Layout>

<style>
  .container {
    width: min(900px, calc(100% - 3rem));
    margin: 0 auto;
  }

  section {
    margin-bottom: 5rem;
  }

  .hero {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  h2 {
    margin-top: 1rem;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
  }

  .introduction {
    max-width: 650px;
    font-size: 1.2rem;
    color: #4b5563;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .links a {
    display: inline-block;
    padding: 0.7rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background: white;
    text-decoration: none;
  }

  .links a:hover {
    border-color: #6b7280;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skills span {
    padding: 0.5rem 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    background: white;
  }

  @media (max-width: 600px) {
    .container {
      width: min(100% - 2rem, 900px);
    }

    .hero {
      min-height: auto;
      padding: 4rem 0;
    }
  }
</style>