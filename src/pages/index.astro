---
const name = "Garrett Denton";
const title = "Data Engineering & Business Intelligence";
const introduction =
  "Business Intelligence and ETL/ELT professional building more data engineering experience through hands-on projects, technical documentation, and continuous learning.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`${name} — ${title}`} />
    <title>{name} | {title}</title>
  </head>

  <body>
    <main>
      <section class="hero">
        <p class="eyebrow">DATA ENGINEERING · BUSINESS INTELLIGENCE</p>

        <h1>{name}</h1>

        <h2>{title}</h2>

        <p class="introduction">{introduction}</p>

        <div class="links">
          <a href="/resume">Resume</a>
          <a href="/projects">Projects</a>
          <a
            href="https://github.com/garrettpdenton"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        </div>
      </section>

      <section>
        <h2>Core Skills</h2>

        <div class="skills">
          <span>SQL</span>
          <span>Python</span>
          <span>Data Engineering</span>
          <span>Data Warehousing</span>
          <span>ETL / ELT</span>
          <span>Business Intelligence</span>
          <span>Cloud Data Platforms</span>
          <span>Data Modeling</span>
        </div>
      </section>

      <section>
        <h2>Currently Learning</h2>

        <p>
          Building deeper experience in modern data engineering, cloud
          platforms, orchestration, CI/CD, and MLOps through hands-on projects.
        </p>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    line-height: 1.6;
    color: #1f2937;
    background: #f8fafc;
  }

  main {
    width: min(900px, calc(100% - 3rem));
    margin: 0 auto;
    padding: 5rem 0;
  }

  section {
    margin-bottom: 5rem;
  }

  .hero {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  h2 {
    margin-top: 1rem;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
  }

  .introduction {
    max-width: 650px;
    font-size: 1.2rem;
    color: #4b5563;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .links a {
    display: inline-block;
    padding: 0.7rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
    background: white;
  }

  .links a:hover {
    border-color: #6b7280;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skills span {
    padding: 0.5rem 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    background: white;
  }

  @media (max-width: 600px) {
    main {
      width: min(100% - 2rem, 900px);
      padding: 3rem 0;
    }

    .hero {
      min-height: auto;
    }
  }
</style>